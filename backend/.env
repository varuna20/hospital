# ================================================
# HOSPITAL ECHANNELING SYSTEM v3 — Environment
# Copy this to .env and fill in your values
# ================================================

# Server
PORT=5000
NODE_ENV=development   # change to 'production' when live

# MongoDB — get a free cluster at https://mongodb.com/atlas
MONGO_URI=mongodb+srv://varuna20_db_user:d6bWTwM0DtQ1ZA4j@hospital.mnf61eq.mongodb.net/hospital_system?appName=Hospital
# For Atlas: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/hospital_echanneling

# JWT — MUST be changed in production (use 32+ random characters)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARACTERS
JWT_EXPIRE=7d

# Frontend URL (for CORS — must match exactly)
FRONTEND_URL=http://localhost:5173
# In production: FRONTEND_URL=https://yourdomain.com

# Backup storage
BACKUP_DIR=./backups       # local path
BACKUP_CRON=0 1 * * *      # daily at 1 AM (cron syntax)

# Twilio WhatsApp (per-hospital settings override these)
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SMTP Email (used for billing and system alerts)
# Gmail example: use App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# File upload limits
MAX_LOGO_SIZE_MB=5
MAX_VIDEO_SIZE_MB=200
